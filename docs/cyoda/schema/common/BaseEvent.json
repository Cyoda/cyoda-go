{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyoda.com/cloud/event/common/BaseEvent.json",
  "title": "BaseEvent",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Flag indicates whether this message relates to some failure.",
      "default": true
    },
    "id": {
      "type": "string",
      "description": "Event ID."
    },
    "error": {
      "type": "object",
      "description": "Error details (if present).",
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code."
        },
        "message": {
          "type": "string",
          "description": "Error message."
        },
        "retryable": {
          "type": "boolean",
          "description": "Whether the sender judges that repeating the request could succeed. On a calculation response this is the compute member's verdict: cyoda passes it on to the client of the failed operation and does not give the work to another compute member because of it."
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "warnings": {
      "type": "array",
      "description": "Warnings (if applicable).",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id"
  ]
}